{
  "theme": "Ravenwood",
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "buffer_font_family": "{{FONT_FAMILY}}",
  "ui_font_family": "{{FONT_FAMILY}}",
  "autosave": "on_focus_change",
  "tab_bar": {
    "show": true
  },
  "languages": {
    "Bash": {
      "tab_size": 4,
      "formatter": "shfmt"
    },
    "Shell Script": {
      "tab_size": 4
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": false,
  "relative_line_numbers": true,
  "indent_guides": {
    "enabled": true
  },
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path_lookup": true
      }
    }
  }
}
