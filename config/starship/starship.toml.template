#
# Pimarchy Starship Configuration
# Matches the live Omarchy prompt: minimal single line, cyan accents.
#

format = "[$directory$git_branch$git_status]($style)$character"
command_timeout = 200
add_newline = true

[character]
success_symbol = "[❯](bold cyan)"
error_symbol = "[✗](bold cyan)"

[directory]
truncation_length = 2
truncation_symbol = "…/"
style = "bold cyan"
format = "[$path]($style)[$read_only]($read_only_style) "
read_only_style = "cyan"
repo_root_style = "bold cyan"
before_repo_root_style = "cyan"

[git_branch]
symbol = "⎇ "
style = "italic cyan"
format = "[$symbol$branch]($style) "

[git_status]
style = "italic cyan"
format = '[$all_status$ahead_behind]($style) '
# Blank most states like the live prompt (keep only ahead/behind)
modified = ""
staged = ""
renamed = ""
deleted = ""
untracked = ""
stashed = ""
conflicted = ""
ahead = "⇡${count} "
behind = "⇣${count} "
diverged = "⇕${ahead_count}${behind_count} "