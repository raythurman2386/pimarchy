/* Pimarchy Waybar Theme — live Omarchy bar look: opaque bg, flat modules */

* {
    /* Sans for letters/digits, Propo only for Nerd Font icons. Color-emoji
       in this stack makes glyphs paint as bitmaps and look muddy. */
    font-family: "{{FONT_UI}}", "{{FONT_ICON}}", sans-serif;
    font-size: {{FONT_SIZE_PX}}px;
    font-weight: normal;
    letter-spacing: 0;
    border: none;
    border-radius: 0;
    min-height: 0;
    text-shadow: none;
    box-shadow: none;
    background-image: none;
    -gtk-icon-shadow: none;
}

window#waybar {
    background-color: {{BAR_BG_COLOR}};
    background-image: none;
    color: {{BAR_FG_COLOR}};
    border-bottom: 1px solid {{BAR_BORDER_COLOR}};
}

button {
    background-image: none;
    border: none;
    box-shadow: none;
    text-shadow: none;
}

label {
    text-shadow: none;
}

/* All modules base style — flat, no radii, live spacing */
#clock,
#memory,
#pulseaudio,
#network,
#bluetooth,
#custom-battery,
#custom-launcher,
#custom-power,
#custom-update,
#custom-ws1,
#custom-ws2,
#custom-ws3,
#custom-ws4,
#custom-ws5,
#tray {
    padding: 0 8px;
    margin: 0;
    background-color: {{MODULE_BG_COLOR}};
    border-radius: 0;
    color: {{BAR_FG_COLOR}};
    transition: background-color 0.2s ease;
}

/* Module Hover states */
#memory:hover,
#pulseaudio:hover,
#network:hover,
#bluetooth:hover,
#clock:hover {
    background-color: {{MODULE_HOVER_BG_COLOR}};
}

/* Launcher */
#custom-launcher {
    font-size: 15px;
    color: {{COLOR_PRIMARY}};
    background-color: {{LAUNCHER_BG_COLOR}};
}
#custom-launcher:hover {
    background-color: {{LAUNCHER_HOVER_BG_COLOR}};
}

/* Workspaces — custom chips (hyprland/workspaces click uses a dispatch
   syntax Hyprland 0.56's Lua IPC rejects). */
#custom-ws1,
#custom-ws2,
#custom-ws3,
#custom-ws4,
#custom-ws5 {
    padding: 0 8px;
    min-width: 24px;
    min-height: {{BAR_HEIGHT}}px;
    font-size: 12px;
    font-weight: normal;
    border-radius: 0;
    background-color: {{MODULE_BG_COLOR}};
    color: {{COLOR_INACTIVE}};
    transition: color 0.2s ease, background-color 0.2s ease;
}
#custom-ws1:hover,
#custom-ws2:hover,
#custom-ws3:hover,
#custom-ws4:hover,
#custom-ws5:hover {
    background-color: {{MODULE_HOVER_BG_COLOR}};
}
#custom-ws1.active,
#custom-ws2.active,
#custom-ws3.active,
#custom-ws4.active,
#custom-ws5.active {
    color: {{COLOR_ACTIVE}};
}

/* Clock */
#clock {
    font-family: "{{FONT_UI}}", "{{FONT_ICON}}", sans-serif;
    letter-spacing: 0;
    color: {{COLOR_TEXT}};
    background-color: {{CLOCK_BG_COLOR}};
}

/* Hardware Info */
#memory.warning {
    color: {{COLOR_WARNING}};
}

#memory {
    color: {{COLOR_MEMORY}};
}

/* Network */
#network {
    color: {{COLOR_ORANGE}};
}
#network.disconnected {
    color: {{COLOR_DISCONNECTED}};
}

/* Bluetooth */
#bluetooth {
    color: {{COLOR_INFO}};
}
#bluetooth.disabled {
    color: {{COLOR_DISCONNECTED}};
}

/* Battery (custom module; absent on headless Pi 5) */
#custom-battery {
    color: {{COLOR_MEMORY}};
}

/* Audio */
#pulseaudio {
    color: {{COLOR_VOLUME}};
}
#pulseaudio.muted {
    color: {{COLOR_MUTED}};
}

/* Tray */
#tray > .passive {
    -gtk-icon-effect: dim;
}
#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background-color: {{TRAY_ATTENTION_RGBA}};
}

/* Power Menu */
#custom-power {
    font-size: 14px;
    color: {{COLOR_POWER}};
    background-color: {{POWER_BG_COLOR}};
}
#custom-power:hover {
    background-color: {{POWER_HOVER_BG_COLOR}};
}

/* Update Indicator */
#custom-update {
    font-size: 15px;
    color: {{COLOR_PRIMARY}};
    background-color: {{LAUNCHER_BG_COLOR}};
    animation: pulse 2s ease-in-out infinite;
}
#custom-update:hover {
    background-color: {{LAUNCHER_HOVER_BG_COLOR}};
}

@keyframes pulse {
    0%   { opacity: 1.0; }
    50%  { opacity: 0.55; }
    100% { opacity: 1.0; }
}

/* Tooltips */
tooltip {
    background-color: {{BAR_BG_COLOR}};
    background-image: none;
    border: 1px solid {{ROFI_BORDER_COLOR}};
    border-radius: 0;
    padding: 4px 2px;
    text-shadow: none;
    box-shadow: none;
}
tooltip label {
    color: {{BAR_FG_COLOR}};
    padding: 4px 8px;
    text-shadow: none;
}