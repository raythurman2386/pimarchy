#
# Pimarchy Hyprland Configuration
# Raspberry Pi 500 Optimized
#

# ============================================================================
# Monitor Settings
# ============================================================================
monitor=,preferred,auto,1

# ============================================================================
# Environment Variables (Pi 500 VideoCore VII)
# ============================================================================
env = XCURSOR_SIZE,{{CURSOR_SIZE}}
env = XCURSOR_THEME,{{CURSOR_THEME}}
env = QT_QPA_PLATFORMTHEME,qt5ct
# WLR_DRM_DEVICES/AQ_DRM_DEVICES is set at launch time by start-hyprland.sh (auto-detected)
# VC4 has no hardware cursor plane support in wlroots — software cursors (Pi-specific)
env = WLR_RENDERER,gles2
env = WLR_NO_HARDWARE_CURSORS,1
env = AQ_NO_HARDWARE_CURSORS,1
env = GDK_BACKEND,wayland,x11

# ============================================================================
# Autostart
# ============================================================================
# NOTE: waybar and mako are managed by systemd user services (graphical-session.target)
# and must NOT be started here — doing so causes duplicate instances under UWSM.

# Polkit agent — needed for GUI auth dialogs (e.g. sudo prompts from apps)
exec-once = lxpolkit

# ============================================================================
# Input (matches live Omarchy input.lua)
# ============================================================================
input {
    kb_layout = {{KEYBOARD_LAYOUT}}
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =

    follow_mouse = 1

    touchpad {
        natural_scroll = no
    }

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    # Live-parity typing feel
    repeat_rate = 40
    repeat_delay = 250
    numlock_by_default = true
}

# ============================================================================
# General (gaps/borders match live looknfeel)
# ============================================================================
general {
    gaps_in = {{GAPS_IN}}
    gaps_out = {{GAPS_OUT}}
    border_size = {{BORDER_SIZE}}
    col.active_border = {{BORDER_ACTIVE}}
    col.inactive_border = {{BORDER_INACTIVE}}

    layout = dwindle
}

# ============================================================================
# Decoration — zero cost on the Pi: no rounding, blur, or shadows
# ============================================================================
decoration {
    rounding = {{CORNER_RADIUS}}

    blur {
        enabled = false
    }

    shadow {
        enabled = false
    }
}

# ============================================================================
# Animations (live Omarchy tuning; workspace anim off — the expensive one)
# ============================================================================
animations {
    enabled = yes

    bezier = easeOutQuint,0.23,1,0.32,1
    bezier = easeInOutCubic,0.65,0,0.35,1
    bezier = linear,0,0,1,1
    bezier = almostLinear,0.5,0.5,0.5,0.5
    bezier = quick,0.15,0,0.1,1

    animation = global,1,10,default
    animation = windows,1,3.79,easeOutQuint
    animation = windowsIn,1,4.1,quick,popin 87%
    animation = windowsOut,1,1.49,linear,popin 87%
    animation = fadeIn,1,1.73,almostLinear
    animation = fadeOut,1,1.46,almostLinear
    animation = fade,1,3.03,quick
    animation = layers,1,3.81,easeOutQuint
    animation = fadeLayersIn,1,1.79,almostLinear
    animation = fadeLayersOut,1,1.39,almostLinear
    animation = workspaces,0,1,default
    animation = specialWorkspace,1,3,easeOutQuint,slidevert
}

# ============================================================================
# Misc / Cursor (live parity)
# ============================================================================
misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    focus_on_activate = true
}

cursor {
    hide_on_key_press = true
    warp_on_change_workspace = 1
}

# ============================================================================
# Layouts
# ============================================================================
dwindle {
    preserve_split = yes
}

master {
    new_status = master
}

# ============================================================================
# Window Rules
# ============================================================================
# Live opacity tuning: slightly transparent, browsers near-opaque
windowrule = match:class .*, opacity {{OPACITY_DEFAULT}}
windowrule = match:class .*(chromium|Chromium).*, opacity {{OPACITY_BROWSER}}
# Floating terminal for btop (launched by keybind / waybar clicks)
windowrule = match:class ^(btop)$, float 1, size 900 600, center 1
# Floating terminal for pimarchy update (launched by waybar update widget)
windowrule = match:class ^(pimarchy-update)$, float 1, size 800 500, center 1
# Coding agent — Quattro-style, own window class for theming
windowrule = match:class ^(raven)$, float 1, size 900 600, center 1

# ============================================================================
# Keybinds
# ============================================================================
# Note: 'bindd' includes a description field used by pimarchy-keybindings
# to build the live keybindings viewer (Super+K).
# Keybinds live in bindings.conf (sourced below) so app defaults can be
# templated from `pimarchy default <agent|browser|editor|terminal>`.
source = ~/.config/hypr/bindings.conf